# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local
# 예시 파일은 실제 값이 없으므로 예외로 둡니다 (여기에 진짜 키를 적지 마세요)
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local project link state (machine-specific, not a source file)
/supabase/.temp/

# 로컬 작업 산출물: 배포용으로 손으로 만든 zip과 스크립트 실행 결과 파일.
# 파일 자체는 지우지 않는다 — 여기서 Git 추적 대상에서만 뺀다.
# *.zip을 통째로 무시하지 않는다. 아래 이름에 해당하는 것만 뺀다.
/aroeda-*.zip
/recommend-scripture-coverage-gap-v1*.zip
/research-prioritizer-deploy.zip
/research-prioritizer-deploy-manifest.txt
/domain-output.txt
/stress-output.txt

# 자동 Scripture Catalog 분석 실행기(scripts/automatic-scripture-catalog-analysis-runner-cli.ts)의
# 로컬 체크포인트·최종 스냅샷 산출물. 실제 경로는 --checkpoint/--snapshot 인자로 호출자가
# 정하지만, 로컬에서 직접 --execute를 돌려볼 때는 이 이름의 디렉터리를 쓰는 관례를 둔다.
# *.json을 통째로 무시하지 않는다 — 이 디렉터리 이름만 좁게 뺀다.
/automatic-scripture-catalog-analysis-runner.local/
/automatic-scripture-catalog-analysis-runner-v2.local/
/automatic-scripture-catalog-analysis-runner-v3.local/
/automatic-scripture-catalog-analysis-runner-v3-final.local/
/automatic-scripture-catalog-analysis-runner-v3-final2.local/
/automatic-scripture-catalog-analysis-runner-v3-final3.local/
/automatic-scripture-catalog-analysis-runner-v4.local/
/automatic-scripture-catalog-analysis-runner-v4-final.local/
/automatic-scripture-catalog-analysis-runner-v4-final2.local/
/automatic-scripture-catalog-analysis-runner-v4-final3.local/
/automatic-scripture-catalog-analysis-runner-v4-final4.local/
