# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local
# 예시 파일은 실제 값이 없으므로 예외로 둡니다 (여기에 진짜 키를 적지 마세요)
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local project link state (machine-specific, not a source file)
/supabase/.temp/

# 로컬 작업 산출물: 배포용으로 손으로 만든 zip과 스크립트 실행 결과 파일.
# 파일 자체는 지우지 않는다 — 여기서 Git 추적 대상에서만 뺀다.
# *.zip을 통째로 무시하지 않는다. 아래 이름에 해당하는 것만 뺀다.
/aroeda-*.zip
/recommend-scripture-coverage-gap-v1*.zip
/research-prioritizer-deploy.zip
/research-prioritizer-deploy-manifest.txt
/domain-output.txt
/stress-output.txt
